# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team_task_db?schema=public

# JWT
JWT_SECRET=change_me_strong_secret

# Server
NODE_ENV=development # set to "production" on deployed servers — disables the /api-docs Swagger UI
PORT=4001

# Extra browser origins allowed by CORS, comma-separated, no trailing slash.
# Any localhost origin is always allowed outside production.
CORS_ORIGINS=

# Number of reverse proxies in front of this app — 1 for a single nginx, unset when exposed
# directly. Without it every visitor shares one rate-limit bucket. Setting it when there is no
# proxy lets clients forge their own IP with an X-Forwarded-For header.
# Defaults to 1 on Vercel, which overwrites X-Forwarded-For with the real client IP.
TRUST_PROXY_HOPS=
